{
  "build": {
    "distDir": "../out",
    "devPath": "http://localhost:3000",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "package": {
    "productName": "WhisperType",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": true
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.whispertype.app",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 720,
        "resizable": true,
        "title": "WhisperType Voice OS Dashboard",
        "width": 1080,
        "label": "main",
        "visible": true
      },
      {
        "fullscreen": false,
        "height": 100,
        "width": 450,
        "resizable": false,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "title": "WhisperType Overlay",
        "label": "overlay",
        "visible": false,
        "center": true,
        "skipTaskbar": true
      }
    ]
  }
}
